; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GlisteningSorrel"
config/version="1.1"
run/main_scene="res://examples/scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="uid://c5cpcg65ja57j"

[audio]

buses/default_bus_layout="uid://bbrewbtxs8g5c"
general/default_playback_type.web=0

[autoload]

AppConfig="*uid://cjke6crjg14a0"
SceneLoader="*uid://cbwmrnp0af35y"
TextManager="*uid://d3qvsk17re04p"
Globals="*uid://c6quv4ryutpqt"

[display]

window/size/borderless=true
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"

[editor_plugins]

enabled=PackedStringArray("res://addons/maaacks_game_template/plugin.cfg")

[gui]

theme/custom="res://examples/resources/themes/expedition.tres"

